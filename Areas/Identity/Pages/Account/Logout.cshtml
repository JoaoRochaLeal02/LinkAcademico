@page
@model LogoutModel

@{
    ViewData["Title"] = "Sair";
}

<style>

    body {
        background: radial-gradient(circle at top left, rgba(10,102,194,.12), transparent 28%), radial-gradient(circle at bottom right, rgba(0,65,130,.10), transparent 28%), #f4f7fb;
        min-height: 100vh;
    }

    .logout-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px;
    }

    .logout-card {
        width: 100%;
        max-width: 520px;
        background: rgba(255,255,255,.82);
        backdrop-filter: blur(18px);
        border-radius: 30px;
        border: 1px solid rgba(255,255,255,.7);
        box-shadow: 0 20px 50px rgba(0,0,0,.08);
        overflow: hidden;
    }

    .logout-top {
        height: 8px;
        background: linear-gradient(90deg, #0a66c2, #004182);
    }

    .logout-body {
        padding: 45px;
        text-align: center;
    }

    .logout-icon {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0a66c2, #004182);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 25px auto;
        font-size: 2rem;
        box-shadow: 0 10px 30px rgba(10,102,194,.25);
    }

    .logout-title {
        font-size: 2.2rem;
        font-weight: 800;
        margin-bottom: 12px;
        color: #111;
    }

    .logout-subtitle {
        color: #666;
        line-height: 1.8;
        margin-bottom: 35px;
    }

    .btn-logout {
        height: 58px;
        border: none;
        border-radius: 999px;
        background: linear-gradient(135deg, #0a66c2, #004182);
        font-weight: 700;
        font-size: 1rem;
        transition: .25s;
    }

        .btn-logout:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(10,102,194,.22);
        }

</style>

<div class="logout-wrapper">

    <div class="logout-card">

        <div class="logout-top"></div>

        <div class="logout-body">

            <div class="logout-icon">

                <i class="bi bi-box-arrow-right"></i>

            </div>

            <div class="logout-title">
                Encerrar sessão
            </div>

            <div class="logout-subtitle">
                Você está prestes a sair da plataforma.
                Deseja realmente encerrar sua sessão?
            </div>

            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home")"
                  method="post">

                <button type="submit"
                        class="btn btn-primary btn-logout w-100">

                    Sair da conta

                </button>

            </form>

        </div>

    </div>

</div>