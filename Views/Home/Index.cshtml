@model IEnumerable<LinkAcademico.Models.Experiencia>

@using LinkAcademico.Models

@{
    ViewData["Title"] = "Início";

    var empresas =
        ViewBag.Empresas as List<Empresa>;

    var vagas =
        ViewBag.Vagas as List<Vaga> ?? new List<Vaga>();

    var vagasMercado =
        ViewBag.VagasMercado as List<Vaga> ?? new List<Vaga>();

    var totalExperiencias =
        ViewBag.TotalExperiencias as int? ?? Model.Count();

    var estudanteLogado =
        ViewBag.EstudanteLogado as Estudante;

    var empresaLogada =
        ViewBag.EmpresaLogada as Empresa;

    var habilidadesEstudante =
        estudanteLogado?.Habilidades?
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(h => h.Trim())
        .Where(h => !string.IsNullOrWhiteSpace(h))
        .Take(8)
        .ToList() ?? new List<string>();

    var tecnologiasEmpresa =
        empresaLogada?.Tecnologias?
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(t => t.Trim())
        .Where(t => !string.IsNullOrWhiteSpace(t))
        .Take(8)
        .ToList() ?? new List<string>();

    var vagasEmpresaAtivas =
        empresaLogada?.Vagas?.Count(v => v.Ativa) ?? 0;

    var vagasEmpresaTotal =
        empresaLogada?.Vagas?.Count ?? 0;
}

<style>

    /* HERO */

    .hero-section {
        background: linear-gradient(90deg, rgba(15, 29, 45, .88), rgba(15, 66, 109, .76)), url('https://images.unsplash.com/photo-1522202176988-66273c2fd55f?q=80&w=1600&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        border-radius: 10px;
        padding: 38px 36px;
        color: white;
        overflow: hidden;
        position: relative;
        box-shadow: 0 12px 30px rgba(23,33,47,.12);
        border: 1px solid rgba(255,255,255,.26);
    }

    .hero-title {
        font-size: clamp(1.9rem, 3vw, 2.7rem);
        font-weight: 800;
        margin-bottom: 10px;
