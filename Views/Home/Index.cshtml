    }

    .student-summary-line {
        display: flex;
        gap: 8px;
        align-items: flex-start;
        color: #475467;
        font-size: .9rem;
    }

        .student-summary-line i {
            color: #1769aa;
            width: 18px;
            text-align: center;
            margin-top: 1px;
            flex-shrink: 0;
        }

    .student-summary-skills {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 14px;
    }

    .student-summary-actions {
        display: grid;
        gap: 8px;
    }

    /* TRENDS */

    .trend-item {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-bottom: 14px;
    }

        .trend-item:last-child {
            margin-bottom: 0;
        }

    .trend-icon {
        width: 42px;
        height: 42px;
        border-radius: 8px;
        background: #f0f4f8;
        color: #1769aa;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .trend-name {
        font-weight: 700;
        color: #17212f;
    }

    .trend-desc {
        color: #667085;
        font-size: .9rem;
    }

    /* DICAS */

    .tip-item {
        background: #f7fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 12px;
        margin-bottom: 10px;
        color: #444;
        line-height: 1.6;
    }

        .tip-item i {
            color: #1769aa;
            margin-right: 8px;
        }

    /* EMPRESAS MINI */

    .company-mini {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-bottom: 14px;
    }

        .company-mini:last-child {
            margin-bottom: 0;
        }

    .company-mini-icon {
        width: 42px;
        height: 42px;
        border-radius: 8px;
        background: linear-gradient(135deg, #1769aa, #15836d);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .company-mini-name {
        font-weight: 700;
        color: #17212f;
    }

    .company-mini-area {
        color: #667085;
        font-size: .9rem;
    }

    /* RESPONSIVO */

    @@media (max-width: 768px) {

        .hero-section {
            padding: 30px 20px;
        }

        .hero-title {
            font-size: 2rem;
        }

        .hero-buttons {
            flex-direction: column;
        }

        .home-section-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .home-jobs-grid,
        .home-feed-grid {
            grid-template-columns: 1fr;
        }
    }

</style>

<!-- HERO -->

<div class="hero-section">

    <h1 class="hero-title">
        Bem-vindo ao Link Acadêmico
    </h1>

    <p class="hero-subtitle">

        Conecte estudantes, empresas e oportunidades
        em uma plataforma moderna inspirada no LinkedIn.

    </p>

    <div class="hero-buttons">

        <a asp-controller="Estudantes"
               asp-action="Buscar"
               class="btn-linkedin">

            Explorar estudantes

        </a>

        <a asp-controller="Empresas"
               asp-action="Index"
               class="btn-outline-custom">

            Ver empresas

        </a>

    </div>

</div>

<!-- VAGAS PARA ESTUDANTES -->
@if (User.IsInRole("Estudante"))
{
    <section class="home-jobs-section">

        <div class="home-section-header">

            <div class="section-title">
                Vagas disponíveis para você
            </div>

            <a asp-controller="Vagas"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                Ver todas
            </a>

        </div>

        @if (vagas.Any())
        {
            <div class="home-jobs-grid">

                @foreach (var vaga in vagas)
                {
                    <article class="home-job-card">

                        <div class="home-job-company">
                            @(vaga.Empresa?.Nome ?? "Empresa parceira")
                        </div>

                        <div class="home-job-title">
                            @vaga.Titulo
                        </div>

                        <div class="home-job-meta">

                            @if (!string.IsNullOrWhiteSpace(vaga.ModeloTrabalho))
                            {
                                <span class="home-job-pill">
                                    @vaga.ModeloTrabalho
                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(vaga.TipoVaga))
                            {
                                <span class="home-job-pill">
                                    @vaga.TipoVaga
                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(vaga.Local))
                            {
                                <span class="home-job-pill">
                                    @vaga.Local
                                </span>
                            }

                        </div>

                        <p class="home-job-desc">
                            @(vaga.Descricao.Length > 130
                                ? vaga.Descricao.Substring(0, 130) + "..."
                                : vaga.Descricao)
                        </p>

                        <div class="home-job-footer">

                            <span class="text-muted small">
                                @vaga.Candidaturas.Count candidatura(s)
                            </span>

                            <a asp-controller="Vagas"
                                   asp-action="Details"
                                   asp-route-id="@vaga.Id"
                                   class="btn btn-primary">
                                Ver e candidatar-se
                            </a>

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="home-jobs-empty">
                Nenhuma vaga ativa foi publicada ainda.
            </div>
        }

    </section>
}

<!-- CONTEÚDO -->

<div class="row mt-5">

    <!-- FEED -->

    <div class="col-lg-8">

        <div class="section-title">
            Experiências em Destaque
        </div>

        <div class="home-feed-grid">

            @foreach (var exp in Model)
            {
                <div class="home-feed-card">

                    @if (!string.IsNullOrEmpty(exp.ImagemUrl))
                    {
                        <img src="@exp.ImagemUrl"
                             class="home-feed-image" />
                    }
                    else
                    {
                        <div class="home-feed-placeholder">

                            <i class="bi bi-image"></i>

                        </div>
                    }

                    <div class="home-feed-content">

                        <div class="home-feed-category">
                            @exp.Categoria
                        </div>

                        <div class="home-feed-title-card">
                            @exp.Titulo
                        </div>

                        <div class="home-feed-date">

                            <i class="bi bi-calendar-event"></i>

                            @exp.Data.ToString("dd/MM/yyyy")

                        </div>

                        <p class="text-muted">

                            @(exp.Descricao.Length > 180
                                ? exp.Descricao.Substring(0, 180) + "..."
                                : exp.Descricao)

                        </p>

                        @if (!string.IsNullOrEmpty(exp.Competencias))
                        {
                            <div class="mt-3">

                                @foreach (var skill in exp.Competencias.Split(','))
                                {
                                    <span class="skill-badge">

                                        @skill.Trim()

                                    </span>
                                }

                            </div>
                        }

                        <div class="home-feed-user">

                            @if (!string.IsNullOrEmpty(exp.Estudante?.FotoPerfil))
                            {
                                <img src="@exp.Estudante.FotoPerfil"
                                     class="feed-user-photo" />
                            }
                            else
                            {
                                <img src="/images/default-user.png"
                                     class="feed-user-photo" />
                            }

                            <a asp-controller="Estudantes"
                                   asp-action="Perfil"
                                   asp-route-id="@exp.EstudanteId">

                                @exp.Estudante?.Nome

                            </a>

                        </div>

                        <div class="mt-4 d-flex gap-2 flex-wrap">

                            <a asp-controller="Experiencias"
                                   asp-action="Details"
                                   asp-route-id="@exp.Id"
                                   class="btn btn-outline-primary rounded-pill">

                                Ver detalhes

                            </a>

                            @if (!string.IsNullOrEmpty(exp.ProjetoUrl))
                            {
                                <a href="@exp.ProjetoUrl"
                                       target="_blank"
                                       class="btn btn-primary rounded-pill">

                                    Projeto

                                </a>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>

        @if (User.IsInRole("Empresa"))
        {
            <section class="home-jobs-section">

                <div class="home-section-header">

                    <div>
                        <div class="section-title">
                            Referências de vagas no mercado
                        </div>
                        <div class="text-muted">
                            Veja como outras empresas estão divulgando oportunidades na plataforma.
                        </div>
                    </div>

                    <a asp-controller="Vagas"
                           asp-action="Index"
                           class="btn btn-outline-primary">
                        Ver todas
                    </a>

                </div>

                @if (vagasMercado.Any())
                {
                    <div class="home-jobs-grid">

                        @foreach (var vaga in vagasMercado)
                        {
                            <article class="home-job-card">

                                <div class="home-job-company">
                                    @(vaga.Empresa?.Nome ?? "Empresa parceira")
                                </div>

                                <div class="home-job-title">
                                    @vaga.Titulo
                                </div>

                                <div class="home-job-meta">

                                    @if (!string.IsNullOrWhiteSpace(vaga.ModeloTrabalho))
                                    {
                                        <span class="home-job-pill">
                                            @vaga.ModeloTrabalho
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(vaga.TipoVaga))
                                    {
                                        <span class="home-job-pill">
                                            @vaga.TipoVaga
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(vaga.Local))
                                    {
                                        <span class="home-job-pill">
                                            @vaga.Local
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(vaga.Remuneracao))
                                    {
                                        <span class="home-job-pill">
                                            @vaga.Remuneracao
                                        </span>
                                    }

                                </div>

                                <p class="home-job-desc">
                                    @(vaga.Descricao.Length > 130
                                        ? vaga.Descricao.Substring(0, 130) + "..."
                                        : vaga.Descricao)
                                </p>

                                <div class="home-job-footer">

                                    <span class="text-muted small">
                                        @vaga.Candidaturas.Count candidatura(s)
                                    </span>

                                    <a asp-controller="Vagas"
                                           asp-action="Details"
                                           asp-route-id="@vaga.Id"
                                           class="btn btn-primary">
                                        Ver vaga
                                    </a>

                                </div>

                            </article>
                        }

                    </div>
                }
                else
                {
                    <div class="home-jobs-empty">
                        Ainda não há vagas de outras empresas para usar como referência.
                    </div>
                }

            </section>
        }

    </div>

    <!-- SIDEBAR -->

    <div class="col-lg-4">

        @if (User.IsInRole("Estudante") && estudanteLogado != null)
        {
            <div class="right-card mb-4">

                <h4 class="right-title">
                    Seu perfil
                </h4>

                <div class="student-summary-header">

                    <img src="@(string.IsNullOrWhiteSpace(estudanteLogado.FotoPerfil)
                                 ? "/images/default-user.png"
                                 : estudanteLogado.FotoPerfil)"
                         class="student-summary-photo"
                         alt="Foto de perfil" />

                    <div>

                        <div class="student-summary-name">
                            @estudanteLogado.Nome
                        </div>

                        <div class="student-summary-course">
                            @estudanteLogado.Curso
                        </div>

                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(estudanteLogado.Bio))
                {
                    <p class="student-summary-bio">
                        @(estudanteLogado.Bio.Length > 170
                            ? estudanteLogado.Bio.Substring(0, 170) + "..."
                            : estudanteLogado.Bio)
                    </p>
                }

                <div class="student-summary-stats">

                    <div class="student-summary-stat">
                        <span class="student-summary-number">
                            @estudanteLogado.Experiencias.Count
                        </span>
                        <span class="student-summary-label">
                            Experiências
                        </span>
                    </div>

                    <div class="student-summary-stat">
                        <span class="student-summary-number">
                            @estudanteLogado.CandidaturasVagas.Count
                        </span>
                        <span class="student-summary-label">
                            Candidaturas
                        </span>
                    </div>

                </div>

                <div class="student-summary-list">

                    @if (!string.IsNullOrWhiteSpace(estudanteLogado.Periodo))
                    {
                        <div class="student-summary-line">
                            <i class="bi bi-mortarboard"></i>
                            <span>@estudanteLogado.Periodo</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(estudanteLogado.Cidade))
                    {
                        <div class="student-summary-line">
                            <i class="bi bi-geo-alt-fill"></i>
                            <span>@estudanteLogado.Cidade</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(estudanteLogado.Email))
                    {
                        <div class="student-summary-line">
                            <i class="bi bi-envelope-fill"></i>
                            <span>@estudanteLogado.Email</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(estudanteLogado.Telefone))
                    {
                        <div class="student-summary-line">
                            <i class="bi bi-telephone-fill"></i>
                            <span>@estudanteLogado.Telefone</span>
                        </div>
                    }

                </div>

                @if (habilidadesEstudante.Any())
                {
                    <div class="student-summary-skills">

                        @foreach (var habilidade in habilidadesEstudante)
                        {
                            <span class="skill-badge">
                                @habilidade
                            </span>
                        }

                    </div>
                }

                <div class="student-summary-actions">

                    <a asp-controller="Estudantes"
                       asp-action="Perfil"
                       asp-route-id="@estudanteLogado.Id"
                       class="btn btn-primary">
                        Ver perfil completo
                    </a>

                    <a asp-controller="Experiencias"
                       asp-action="Create"
                       class="btn btn-outline-primary">
                        Adicionar experiência
                    </a>

                </div>

            </div>
        }

        @if (User.IsInRole("Empresa") && empresaLogada != null)
        {
            <div class="right-card mb-4">

                <h4 class="right-title">
                    Sua empresa
                </h4>

                <div class="student-summary-header">

                    @if (!string.IsNullOrWhiteSpace(empresaLogada.FotoPerfil))
                    {
                        <img src="@empresaLogada.FotoPerfil"
                             class="student-summary-photo company-summary-photo"
                             alt="Logo da empresa" />
                    }
                    else
                    {
                        <div class="company-summary-placeholder">
                            <i class="bi bi-building-fill"></i>
                        </div>
                    }

                    <div>

                        <div class="student-summary-name">
                            @empresaLogada.Nome
                        </div>

                        <div class="student-summary-course">
                            @(string.IsNullOrWhiteSpace(empresaLogada.AreaAtuacao)
                                ? "Área não informada"
                                : empresaLogada.AreaAtuacao)
                        </div>

                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(empresaLogada.Descricao))
                {
                    <p class="student-summary-bio">
                        @(empresaLogada.Descricao.Length > 170
                            ? empresaLogada.Descricao.Substring(0, 170) + "..."
                            : empresaLogada.Descricao)
                    </p>
                }

                <div class="student-summary-stats">

                    <div class="student-summary-stat">
                        <span class="student-summary-number">
                            @vagasEmpresaAtivas
                        </span>
                        <span class="student-summary-label">
                            Vagas ativas
                        </span>
                    </div>

                    <div class="student-summary-stat">
                        <span class="student-summary-number">
                            @vagasEmpresaTotal
                        </span>
                        <span class="student-summary-label">
                            Vagas publicadas
                        </span>
                    </div>

                </div>

                <div class="student-summary-list">

                    @if (!string.IsNullOrWhiteSpace(empresaLogada.Email))
                    {
                        <div class="student-summary-line">
                            <i class="bi bi-envelope-fill"></i>
                            <span>@empresaLogada.Email</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(empresaLogada.AreaAtuacao))
                    {
                        <div class="student-summary-line">
                            <i class="bi bi-briefcase-fill"></i>
                            <span>@empresaLogada.AreaAtuacao</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(empresaLogada.OQueBusca))
                    {
                        <div class="student-summary-line">
                            <i class="bi bi-stars"></i>
                            <span>
                                @(empresaLogada.OQueBusca.Length > 95
                                    ? empresaLogada.OQueBusca.Substring(0, 95) + "..."
                                    : empresaLogada.OQueBusca)
                            </span>
                        </div>
                    }

                    @if (empresaLogada.EhEgressoEmpreendedor)
                    {
                        <div class="student-summary-line">
                            <i class="bi bi-mortarboard-fill"></i>
                            <span>Egresso empreendedor</span>
                        </div>
                    }

                </div>

                @if (tecnologiasEmpresa.Any())
                {
                    <div class="student-summary-skills">

                        @foreach (var tecnologia in tecnologiasEmpresa)
                        {
                            <span class="skill-badge">
                                @tecnologia
                            </span>
                        }

                    </div>
                }

                <div class="student-summary-actions">

                    <a asp-controller="Empresas"
                       asp-action="Perfil"
                       class="btn btn-primary">
                        Ver perfil da empresa
                    </a>

                    <a asp-controller="Vagas"
                       asp-action="Create"
                       class="btn btn-outline-primary">
                        Publicar vaga
                    </a>

                </div>

            </div>
        }

        <!-- TENDÊNCIAS -->

        <div class="right-card mb-4">

            <h4 class="right-title">
                Tendências
            </h4>

            <div class="trend-item">

                <div class="trend-icon">
                    <i class="bi bi-fire"></i>
                </div>

                <div>

                    <div class="trend-name">
                        ASP.NET Core
                    </div>

                    <div class="trend-desc">
                        Tecnologia em alta
                    </div>

                </div>

            </div>

            <div class="trend-item">

                <div class="trend-icon">
                    <i class="bi bi-cpu"></i>
                </div>

                <div>

                    <div class="trend-name">
                        Inteligência Artificial
                    </div>

                    <div class="trend-desc">
                        Mercado aquecido
                    </div>

                </div>

            </div>

            <div class="trend-item">

                <div class="trend-icon">
                    <i class="bi bi-code-slash"></i>
                </div>

                <div>

                    <div class="trend-name">
                        React + .NET
                    </div>

                    <div class="trend-desc">
                        Stack moderna
                    </div>

                </div>

            </div>

        </div>

        <!-- DICAS -->

        <div class="right-card mb-4">

            <h4 class="right-title">
                Dicas da Plataforma
            </h4>

            <div class="tip-item">

                <i class="bi bi-lightbulb-fill"></i>

                Complete seu perfil com habilidades.

            </div>

            <div class="tip-item">

                <i class="bi bi-lightbulb-fill"></i>

                Adicione experiências com imagens.

            </div>

            <div class="tip-item">

                <i class="bi bi-lightbulb-fill"></i>

                Conecte seu GitHub e LinkedIn.

            </div>

        </div>

        <!-- EMPRESAS -->

        <div class="right-card">

            <h4 class="right-title">
                Empresas em Alta
            </h4>

            @if (empresas != null)
            {
                @foreach (var empresa in empresas.Take(3))
                {
                    <div class="company-mini">

                        <div class="company-mini-icon">

                            <i class="bi bi-building"></i>

                        </div>

                        <div>

                            <div class="company-mini-name">
                                @empresa.Nome
                            </div>

                            <div class="company-mini-area">
                                @empresa.AreaAtuacao
                            </div>

                        </div>

                    </div>
                }
            }

        </div>

    </div>

</div>
