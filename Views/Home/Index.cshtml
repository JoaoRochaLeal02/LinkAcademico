        margin-top: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .home-feed-user a {
            text-decoration: none;
            color: #1769aa;
        }

            .home-feed-user a:hover {
                text-decoration: underline;
            }

    .feed-user-photo {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #fff;
        box-shadow: 0 4px 10px rgba(23,33,47,.12);
    }

    /* SIDEBAR */

    .right-card {
        background: #fff;
        border-radius: 8px;
        padding: 16px;
        border: 1px solid #d8e0ea;
        box-shadow: 0 10px 26px rgba(23,33,47,.06);
    }

    .right-title {
        font-size: 1.2rem;
        font-weight: 800;
