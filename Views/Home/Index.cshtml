    .student-summary-name {
        font-size: 1rem;
        font-weight: 800;
        color: #17212f;
        line-height: 1.25;
    }

    .student-summary-course {
        color: #1769aa;
        font-size: .9rem;
        font-weight: 700;
        margin-top: 2px;
    }

    .student-summary-bio {
        color: #475467;
        font-size: .92rem;
        line-height: 1.55;
        margin-bottom: 14px;
    }

    .student-summary-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 14px;
    }

    .student-summary-stat {
        background: #f7fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 10px;
    }

    .student-summary-number {
        display: block;
        color: #0f426d;
        font-size: 1.2rem;
        font-weight: 800;
        line-height: 1;
    }

    .student-summary-label {
        display: block;
        color: #667085;
        font-size: .78rem;
